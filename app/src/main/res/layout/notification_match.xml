<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#1C1C1E">

    <TextView
        android:id="@+id/tvTournament"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Valorant Champions Tour"
        android:textColor="#8E8E93"
        android:textSize="11sp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPLIT"
            android:textColor="#FFFFFF"
            android:textSize="6sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="2dp" />
        <TextView
            android:id="@+id/tvMapName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPLIT"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:baselineAligned="false">

        <!-- Team A Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/ivTeamA"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_gallery" />
            <TextView
                android:id="@+id/tvTeamA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEAM A"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />


        </LinearLayout>

        <!-- Center Score Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginHorizontal="4dp">

            <TextView
                android:id="@+id/tvArrowA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="#FF4655"
                android:textSize="16sp"
                android:visibility="gone"
                android:layout_marginEnd="4dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="4dp">
                <TextView
                    android:id="@+id/tvScoreTeamA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- CT/T for Team A -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvTeamACT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#4BA2FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" / "
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:letterSpacing="-0.25"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/tvTeamAT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FF4655"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.25"
                        android:includeFontPadding="false"/>
                </LinearLayout>


            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" - "
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="4dp">
                <TextView
                    android:id="@+id/tvScoreTeamB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- CT/T for Team B -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="0dp"
                    android:layout_margin="0dp">
                    <TextView
                        android:id="@+id/tvTeamBCT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#4BA2FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" / "
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:letterSpacing="-0.25"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:id="@+id/tvTeamBT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FF4655"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.25"
                        android:includeFontPadding="false"/>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvArrowB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textColor="#FF4655"
                android:textSize="16sp"
                android:visibility="gone"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Team B Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/ivTeamB"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_gallery" />
            <TextView
                android:id="@+id/tvTeamB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEAM B"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />


        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvMapInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Map 1 | Series 0-0"
        android:textColor="#FF4655"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="2dp" />

</LinearLayout>
